# EXAMPLE ONLY - shows the structure. The REAL file must be encrypted and is
# gitignored (never commit it, even encrypted: this repo is public).
#
# Create the encrypted file and paste each server's sudo password (the deploy
# user's password, from your password manager):
#     ansible-vault create group_vars/fleet/vault.yml
# Edit it later with:
#     ansible-vault edit group_vars/fleet/vault.yml
#
# One entry per host in inventory.local.yml, keyed by the same host name:
vault_become_passwords:
  server1: "REPLACE-with-server1-sudo-password"
  server2: "REPLACE-with-server2-sudo-password"
  server3: "REPLACE-with-server3-sudo-password"
